{
  "version": 2,
  "outputDirectory": "web",
  "functions": {
    "api/server.js": {
      "includeFiles": "web/**"
    }
  },
  "rewrites": [
    {
      "source": "/identify",
      "destination": "/api/server.js"
    },
    {
      "source": "/wiki-summary",
      "destination": "/api/server.js"
    },
    {
      "source": "/image-proxy",
      "destination": "/api/server.js"
    }
  ]
}
